# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop / Claude Code / Zed)
# "streamable-http" — remote HTTP server (containers, cloud deploys)
#
# On a cloud host you usually leave this as stdio: app.py switches to HTTP
# automatically when the platform sets PORT.
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when running over HTTP) ───────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── Portal (defaults point at the live City of Houston portal) ───────────────
# The portal's public read API needs no key.
# CKAN_API_URL=https://data.houstontx.gov/api/3/action/
# PORTAL_URL=https://data.houstontx.gov

# ─── Weather and air quality (Ask Houston+) ───────────────────────────────────
# Weather (National Weather Service) needs no key. Air quality (EPA AirNow) needs
# a free key from https://docs.airnowapi.org. Put the real key in .env only.
# AIRNOW_API_KEY=your-airnow-key
